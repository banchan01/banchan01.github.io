---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
    <!-- Google Fonts: Inter & Outfit (for headings) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;700&display=swap" rel="stylesheet">
		<title>MinChan Kim's Website</title>
    <!-- Apply saved language before first paint to avoid a flash of the wrong language -->
    <script is:inline>
      (function () {
        var lang = 'en';
        try { lang = localStorage.getItem('lang') === 'ko' ? 'ko' : 'en'; } catch (e) {}
        document.documentElement.lang = lang;
      })();
    </script>
	</head>
	<body class="bg-slate-50 text-slate-900 font-sans antialiased selection:bg-emerald-100 selection:text-emerald-900 relative selection:text-emerald-900">
    <!-- Background Patterns -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:24px_24px]"></div>
        <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-emerald-400/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
        <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-blue-400/10 rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
    </div>
    
    <div class="relative z-10 min-h-screen w-full">
      <!-- Language Dropdown (inside the content layer so detail windows cover it) -->
      <div id="lang-menu" class="fixed top-4 right-4 md:top-6 md:right-6 z-40 text-sm">
        <button type="button" id="lang-trigger" aria-haspopup="listbox" aria-expanded="false"
          class="flex items-center gap-2 pl-3.5 pr-3 py-2 bg-white/90 backdrop-blur border border-slate-200 rounded-full shadow-sm font-medium text-slate-600 hover:text-emerald-700 hover:border-emerald-300 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
          </svg>
          <span class="i18n-en">English</span><span class="i18n-ko">한국어</span>
          <svg id="lang-chevron" class="w-3.5 h-3.5 text-slate-400 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <ul id="lang-options" role="listbox" class="hidden absolute left-0 right-0 mt-1.5 p-1 bg-white/95 backdrop-blur border border-slate-200 rounded-2xl shadow-md overflow-hidden">
          <li><button type="button" role="option" data-set-lang="ko" class="lang-option w-full flex items-center justify-between pl-3 pr-2.5 py-1.5 rounded-full text-left font-medium text-slate-600 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">한국어<svg class="lang-check w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></button></li>
          <li><button type="button" role="option" data-set-lang="en" class="lang-option w-full flex items-center justify-between pl-3 pr-2.5 py-1.5 rounded-full text-left font-medium text-slate-600 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">English<svg class="lang-check w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg></button></li>
        </ul>
      </div>
		  <slot />
    </div>
    <script is:inline>
      (function () {
        var menu = document.getElementById('lang-menu');
        var trigger = document.getElementById('lang-trigger');
        var options = document.getElementById('lang-options');
        var chevron = document.getElementById('lang-chevron');
        function setOpen(open) {
          options.classList.toggle('hidden', !open);
          chevron.classList.toggle('rotate-180', open);
          trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        trigger.addEventListener('click', function (e) {
          e.stopPropagation();
          setOpen(options.classList.contains('hidden'));
        });
        options.querySelectorAll('[data-set-lang]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var lang = btn.getAttribute('data-set-lang');
            document.documentElement.lang = lang;
            try { localStorage.setItem('lang', lang); } catch (e) {}
            setOpen(false);
          });
        });
        document.addEventListener('click', function (e) {
          if (!menu.contains(e.target)) setOpen(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') setOpen(false);
        });
      })();
    </script>
	</body>
</html>

<style is:global>
	:root {
    --font-inter: 'Inter', sans-serif;
    --font-outfit: 'Outfit', sans-serif;
	}
  html {
    font-family: var(--font-inter);
    scroll-behavior: smooth;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-outfit);
  }

  /* Language toggle: both languages are in the page, only the active one is shown */
  html[lang="ko"] .i18n-en,
  html:not([lang="ko"]) .i18n-ko {
    display: none !important;
  }
  .lang-check { visibility: hidden; color: #059669; }
  html[lang="ko"] .lang-option[data-set-lang="ko"],
  html:not([lang="ko"]) .lang-option[data-set-lang="en"] {
    color: #047857;
    background-color: #ecfdf5;
  }
  html[lang="ko"] .lang-option[data-set-lang="ko"] .lang-check,
  html:not([lang="ko"]) .lang-option[data-set-lang="en"] .lang-check {
    visibility: visible;
  }
</style>
